<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    tools:context=".MainActivity">

    <!-- 상단 탭 레이아웃 (총 7개 독립 탭) -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E1E1E"
        app:tabTextColor="#888888"
        app:tabSelectedTextColor="#00E676"
        app:tabIndicatorColor="#00E676"
        app:tabMode="scrollable">
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🕹️ 주행/센서" />
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🗺️ SLAM 맵핑" />
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧭 Nav2 자율주행" />
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📡 토픽" />
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙️ 파라미터" />
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📊 RQT 그래프" />
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📜 콘솔 로그" />
    </com.google.android.material.tabs.TabLayout>

    <!-- 공통 상단 상태 바 (2줄 구조) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#181818"
        android:padding="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Domain: "
                android:textColor="#FFF"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/etDomainId"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:text="15"
                android:textColor="#FFF"
                android:inputType="number"
                android:textSize="11sp"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QoS: "
                android:textColor="#AAA"
                android:textSize="11sp"
                android:layout_marginStart="4dp" />

            <Spinner
                android:id="@+id/spnGlobalQos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#00E676"
                android:theme="@style/ThemeOverlay.AppCompat.Dark" />

            <Button
                android:id="@+id/btnNodeToggle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="노드 시작"
                android:textSize="11sp"
                android:textStyle="bold"
                android:backgroundTint="#4CAF50"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/tvBatteryBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔋 --% (--V)"
                android:textColor="#00E676"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="● 중지됨"
                android:textColor="#FF5252"
                android:textSize="11sp"
                android:gravity="end"
                android:paddingEnd="4dp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ==================== TAB 1: 주행 & 센서 ==================== -->
        <ScrollView
            android:id="@+id/tabDriveSensors"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#1E1E1E"
                    android:padding="8dp"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/tvMaxSpeedLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="최대속도: 0.50 m/s"
                        android:textColor="#00E676"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <SeekBar
                        android:id="@+id/sbMaxSpeed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="200"
                        android:progress="50"
                        android:progressTint="#00E676"
                        android:thumbTint="#00E676" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#1E1E1E"
                        android:layout_marginEnd="4dp">

                        <ImageView
                            android:id="@+id/ivCamera"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="/image_raw/compressed"
                            android:textColor="#AAA"
                            android:textSize="9sp"
                            android:padding="4dp" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.2"
                        android:background="#1E1E1E"
                        android:layout_marginStart="4dp">

                        <com.example.ros2_controller.LaserScanView
                            android:id="@+id/laserScanView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="/scan (LiDAR 6m)"
                            android:textColor="#AAA"
                            android:textSize="9sp"
                            android:padding="4dp" />
                    </FrameLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvVelocity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Linear: 0.00 m/s | Angular: 0.00 rad/s (정지)"
                    android:textColor="#00E676"
                    android:gravity="center"
                    android:layout_marginTop="4dp"
                    android:textSize="12sp" />

                <com.example.ros2_controller.JoystickView
                    android:id="@+id/joystickView"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="2dp" />

                <Button
                    android:id="@+id/btnEmergencyStop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="EMERGENCY STOP (cmd_vel: 0)"
                    android:backgroundTint="#D32F2F"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </ScrollView>

        <!-- ==================== TAB 2: 🗺️ SLAM 맵핑 전용 탭 ==================== -->
        <LinearLayout
            android:id="@+id/tabSlamMapping"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="6dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#1E1E1E"
                android:padding="6dp"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🗺️ SLAM 실시간 맵 확장 &amp; 조이스틱 주행"
                    android:textColor="#00E676"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSaveMapFromSlam"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="💾 PC에 맵 저장"
                    android:textSize="10sp"
                    android:backgroundTint="#FF9800"
                    android:textColor="#000"
                    android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#181818">

                <com.example.ros2_controller.MapView
                    android:id="@+id/mapViewSlam"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- SLAM 전용 조이스틱 (우하단 배치) -->
                <com.example.ros2_controller.JoystickView
                    android:id="@+id/mapJoystickView"
                    android:layout_width="145dp"
                    android:layout_height="145dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="12dp"
                    android:alpha="0.85" />
            </FrameLayout>
        </LinearLayout>

        <!-- ==================== TAB 3: 🧭 Nav2 자율주행 전용 탭 ==================== -->
        <LinearLayout
            android:id="@+id/tabNav2Drive"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="6dp"
            android:visibility="gone">

            <!-- 내비게이션 모드 선택 바 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <Button
                    android:id="@+id/btnModeSingleGoal"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:text="목적지"
                    android:textSize="10sp"
                    android:backgroundTint="#00E676"
                    android:textColor="#000"
                    android:layout_marginEnd="1dp" />

                <Button
                    android:id="@+id/btnModeWaypoints"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:text="경유지"
                    android:textSize="10sp"
                    android:backgroundTint="#424242"
                    android:textColor="#FFF"
                    android:layout_marginStart="1dp"
                    android:layout_marginEnd="1dp" />

                <Button
                    android:id="@+id/btnModeInitialPose"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:text="위치추정"
                    android:textSize="10sp"
                    android:backgroundTint="#424242"
                    android:textColor="#FFF"
                    android:layout_marginStart="1dp"
                    android:layout_marginEnd="1dp" />

                <Button
                    android:id="@+id/btnCancelNav"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1.2"
                    android:text="취소"
                    android:textSize="10sp"
                    android:backgroundTint="#D32F2F"
                    android:textColor="#FFF"
                    android:layout_marginStart="1dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#1E1E1E"
                android:padding="6dp"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/tvSelectedGoalPos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="단일 목표 모드: 지도 터치&amp;드래그로 목표 설정"
                    android:textColor="#00E676"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnClearMapMarkers"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="초기화"
                    android:textSize="10sp"
                    android:backgroundTint="#555"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnSendNavGoal"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Goal 전송"
                    android:textSize="10sp"
                    android:backgroundTint="#00E676"
                    android:textColor="#000"
                    android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#181818">

                <com.example.ros2_controller.MapView
                    android:id="@+id/mapViewNav2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>
        </LinearLayout>

        <!-- ==================== TAB 4: 토픽 송수신 (/chatter) ==================== -->
        <LinearLayout
            android:id="@+id/tabTopics"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📤 테스트 토픽 퍼블리시 (/chatter)"
                android:textColor="#00E676"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <EditText
                    android:id="@+id/etChatterMsg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="보낼 문자열 입력"
                    android:text="Hello from Android ROS2!"
                    android:textColor="#FFF"
                    android:textColorHint="#777"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnPublishChatter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="chatter 전송"
                    android:textSize="11sp"
                    android:backgroundTint="#2196F3" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📥 수신 모니터링 (Subscribe Echo)"
                    android:textColor="#00E676"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnClearTopicLog"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="지우기"
                    android:textSize="10sp"
                    android:backgroundTint="#424242" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="수신 토픽: "
                    android:textColor="#AAA"
                    android:textSize="11sp" />

                <Spinner
                    android:id="@+id/spnSubTopics"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="#00E676"
                    android:theme="@style/ThemeOverlay.AppCompat.Dark" />

                <Button
                    android:id="@+id/btnApplySubTopic"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="적용"
                    android:textSize="10sp"
                    android:backgroundTint="#FF9800" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/svTopicEcho"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#181818"
                android:padding="6dp"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvTopicEcho"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#81C784"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:text="[토픽 수신 대기 중...]\n" />
            </ScrollView>
        </LinearLayout>

        <!-- ==================== TAB 5: 파라미터 튜닝 ==================== -->
        <LinearLayout
            android:id="@+id/tabServices"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️ 파라미터 실시간 튜닝 (/param_set_cmd)"
                android:textColor="#00E676"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="노드: "
                    android:textColor="#AAA"
                    android:textSize="11sp" />

                <Spinner
                    android:id="@+id/spnParamNodes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#00E676"
                    android:theme="@style/ThemeOverlay.AppCompat.Dark" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="파라미터: "
                    android:textColor="#AAA"
                    android:textSize="11sp" />

                <Spinner
                    android:id="@+id/spnParams"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#00E676"
                    android:theme="@style/ThemeOverlay.AppCompat.Dark" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <EditText
                    android:id="@+id/etParamValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="변경할 값"
                    android:textColor="#FFF"
                    android:textColorHint="#777"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnSetParam"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="값 변경 (Set &amp; Send)"
                    android:textSize="11sp"
                    android:backgroundTint="#00E676"
                    android:textColor="#000"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#1E1E1E"
                android:padding="6dp"
                android:layout_marginTop="6dp">

                <EditText
                    android:id="@+id/etPresetFileName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="프리셋 파일명"
                    android:text="nav2_custom_preset"
                    android:textColor="#FFF"
                    android:textColorHint="#777"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnSaveParamsPreset"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="💾 프리셋 저장"
                    android:textSize="10sp"
                    android:backgroundTint="#FF9800"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnLoadParamsPreset"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="📂 불러오기"
                    android:textSize="10sp"
                    android:backgroundTint="#2196F3" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋 실시간 파라미터 전송 로그"
                android:textColor="#AAA"
                android:textSize="11sp"
                android:layout_marginTop="8dp" />

            <ScrollView
                android:id="@+id/svParamLog"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#181818"
                android:padding="6dp"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/tvParamLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#81C784"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:text="[파라미터 변경 대기 중...]\n" />
            </ScrollView>
        </LinearLayout>

        <!-- ==================== TAB 6: 📊 RQT 그래프 시각화 ==================== -->
        <LinearLayout
            android:id="@+id/tabRqtGraph"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="6dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#1E1E1E"
                android:padding="6dp"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📊 ROS 2 노드 &amp; 토픽 관계도 (RQT Graph)"
                    android:textColor="#00E676"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnRefreshRqtGraph"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="🔄 새로고침"
                    android:textSize="10sp"
                    android:backgroundTint="#2196F3" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#0F0F0F">

                <com.example.ros2_controller.RqtGraphView
                    android:id="@+id/rqtGraphView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>
        </LinearLayout>

        <!-- ==================== TAB 7: DDS 콘솔 로그 ==================== -->
        <LinearLayout
            android:id="@+id/tabLogs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="DDS 실시간 통신 콘솔"
                    android:textColor="#00E676"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnClearLog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="로그 지우기"
                    android:backgroundTint="#555"
                    android:textSize="11sp" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/svLogScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#0A0A0A"
                android:layout_marginTop="6dp"
                android:padding="6dp">

                <TextView
                    android:id="@+id/tvLogConsole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#A5D6A7"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:text="[DDS Console Ready]\n" />
            </ScrollView>
        </LinearLayout>

    </FrameLayout>
</LinearLayout>